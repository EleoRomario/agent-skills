---
interface Props {
  skill: {
    id: string;
    name: string;
    title: string;
    description: string;
    excerpt: string;
    categories: string[];
    primary: string;
    categorySlug: string;
    accent: string;
    accentInk: string;
    badge: string;
    snippet: { lang: string; lines: string[] };
  };
}

const { skill } = Astro.props;
const accent = skill.accent || "#AFC9BF";
const accentInk = skill.accentInk || "#3d5c52";

function colorize(line: string, lang: string): string {
  const esc = (s: string) =>
    s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  let t = esc(line);
  if (lang === "csharp" || lang === "c#") {
    t = t.replace(
      /\b(public|private|sealed|class|async|await|return|new|using|var|string|int|bool|void|namespace|builder|Services)\b/g,
      '<span class="kw">$1</span>',
    );
  } else if (lang === "bash" || lang === "sh") {
    t = t.replace(
      /\b(npx|npm|pnpm|yarn|git|cd)\b/g,
      '<span class="kw">$1</span>',
    );
  } else if (lang === "python" || lang === "py") {
    t = t.replace(
      /\b(def|return|pass|import|from|class|async|await)\b/g,
      '<span class="kw">$1</span>',
    );
  } else if (
    lang === "javascript" ||
    lang === "js" ||
    lang === "ts" ||
    lang === "typescript"
  ) {
    t = t.replace(
      /\b(const|let|function|return|async|await|import|from|export)\b/g,
      '<span class="kw">$1</span>',
    );
  } else {
    t = t.replace(
      /\b(def|return|const|public|class|npx)\b/g,
      '<span class="kw">$1</span>',
    );
  }
  t = t.replace(
    /(&quot;[^&]*&quot;|"[^"]*"|'[^']*')/g,
    '<span class="str">$1</span>',
  );
  return t;
}
---

<article
  class="skill-card"
  style={`--card-accent: ${accent}; --card-accent-ink: ${accentInk}`}
  data-id={skill.id}
  data-name={skill.name.toLowerCase()}
  data-desc={(skill.description || skill.excerpt || "").toLowerCase()}
  data-cats={skill.categories.join(",")}
  data-selected="false"
>
  <div class="card-top">
    <span class="card-badge" aria-hidden="true">{skill.badge}</span>
    <button
      type="button"
      class="select-toggle"
      aria-pressed="false"
      aria-label={`Seleccionar ${skill.title}`}
      title="Seleccionar para instalar"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.5"
        ></circle>
        <path
          class="check-mark"
          d="M5.5 9.2 L7.8 11.4 L12.5 6.5"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>

  <h2 class="card-title">
    <a class="card-title-link" href={`/skills/${skill.id}`}>{skill.title}</a>
  </h2>
  <p class="card-cat">
    <span class="mark">{skill.categorySlug}</span>
  </p>

  <div class="code-window" aria-hidden="true">
    <div class="code-chrome">
      <span></span><span></span><span></span>
    </div>
    <pre class="code-body"><code
        set:html={skill.snippet.lines
          .map((l) => colorize(l, skill.snippet.lang))
          .join("\n")}
      /></pre>
  </div>
</article>
